# game/scenes/adventure_chapter2.rpy:16
translate english adv_chapter2_5305cc55:

    # narrator "Hafiz tunggu dekat kereta, enjin masih hidup, macam dia pun rasa kampung ni belum habis dengan sesiapa."
    narrator "Hafiz waited by the car with the engine still running, as if he too felt the village was not done with anyone yet."

# game/scenes/adventure_chapter2.rpy:18
translate english adv_chapter2_43b6d11f:

    # narrator "Batu Layar menunggu dengan pintu berkunci dan lampu yang padam."
    narrator "Batu Layar waited with locked doors and darkened lights."

# game/scenes/adventure_chapter2.rpy:20
translate english adv_chapter2_ad53d568:

    # narrator "Lepas tu ada orang menjerit."
    narrator "Then someone screamed."

# game/scenes/adventure_chapter2.rpy:25
translate english adv_chapter2_caf9771d:

    # narrator "Seorang lelaki kampung terhuyung-hayang keluar dari gelap."
    narrator "A village man staggered out of the darkness."

# game/scenes/adventure_chapter2.rpy:26
translate english adv_chapter2_abcc5f7d:

    # narrator "Di belakangnya, ada sesuatu yang pucat dengan kaki terikat."
    narrator "Behind him was something pale, its feet bound together."

# game/scenes/adventure_chapter2.rpy:27
translate english adv_chapter2_3dcec18b:

    # narrator "Satu tubuh yang tak sepatutnya bergerak."
    narrator "A body that should not have been moving."

# game/scenes/adventure_chapter2.rpy:31
translate english adv_chapter2_82bbe7fc:

    # mc "Masuk rumah! Cepat!"
    mc "Get inside! Hurry!"

# game/scenes/adventure_chapter2.rpy:32
translate english adv_chapter2_eb32dac6:

    # narrator "Lelaki tu jatuh masuk ke pintu rumah."
    narrator "The man fell through the doorway."

# game/scenes/adventure_chapter2.rpy:33
translate english adv_chapter2_8860588f:

    # narrator "Benda tu terus berpaling ke arah Aris."
    narrator "The thing immediately turned toward Aris."

# game/scenes/adventure_chapter2.rpy:43
translate english adv_chapter2_acfeb879:

    # narrator "Aris tahan diri daripada bergerak."
    narrator "Aris held himself still."

# game/scenes/adventure_chapter2.rpy:44
translate english adv_chapter2_25e16cd1:

    # narrator "Lelaki kampung itu sempat merangkak masuk ke rumah."
    narrator "The villager managed to crawl into the house."

# game/scenes/adventure_chapter2.rpy:45
translate english adv_chapter2_fb0946c1:

    # narrator "Pocong tu mula perlahan."
    narrator "The creature began to slow down."

# game/scenes/adventure_chapter2.rpy:46
translate english adv_chapter2_bd8b4acf:

    # narrator "Sekejap je. Tapi cukup untuk nampak coraknya."
    narrator "Only for a moment. But long enough to see its pattern."

# game/scenes/adventure_chapter2.rpy:52
translate english adv_chapter2_a1d67f84:

    # narrator "Jari Aris tersentak sebelum dia sempat kawal diri."
    narrator "Aris's fingers twitched before he could stop himself."

# game/scenes/adventure_chapter2.rpy:53
translate english adv_chapter2_cb48f7fa:

    # narrator "Pocong tu terus melompat ke arah gerakan kecil itu."
    narrator "The creature leapt straight toward that small movement."

# game/scenes/adventure_chapter2.rpy:55
translate english adv_chapter2_315e7940:

    # narrator "Lelaki kampung sempat masuk, tapi bahu Aris terkena hentaman kain dan tulang."
    narrator "The villager got inside, but Aris's shoulder was struck by shroud and bone."

# game/scenes/adventure_chapter2.rpy:63
translate english adv_chapter2_fa75f88d:

    # narrator "Bilah keris menangkap cahaya bulan."
    narrator "The keris blade caught the moonlight."

# game/scenes/adventure_chapter2.rpy:64
translate english adv_chapter2_f9964234:

    # narrator "Pocong tu berhenti, kemudian menggigil lebih kuat."
    narrator "The shrouded creature stopped, then trembled harder."

# game/scenes/adventure_chapter2.rpy:72
translate english adv_chapter2_5236dd16:

    # narrator "Aris sempat tutup telinga."
    narrator "Aris managed to cover his ears."

# game/scenes/adventure_chapter2.rpy:75
translate english adv_chapter2_58a8e7cf:

    # narrator "Sesuatu yang berat menghentam bahu dia dalam gelap."
    narrator "Something heavy slammed into his shoulder in the dark."

# game/scenes/adventure_chapter2.rpy:76
translate english adv_chapter2_ae13e65b:

    # narrator "Untuk beberapa saat, dunia tinggal bunyi darah berdenyut dalam kepala."
    narrator "For a few seconds, the world was only the pulse of blood pounding in his head."

# game/scenes/adventure_chapter2.rpy:82
translate english adv_chapter2_2939ab5f:

    # narrator "Dia angkat kamera telefon tepat masa jeritan tu pecah di jalan."
    narrator "He raised his phone camera just as the scream split open the road."

# game/scenes/adventure_chapter2.rpy:91
translate english adv_chapter2_65e97760:

    # narrator "Mula-mula gambar tu nampak macam tak berguna."
    narrator "At first, the photo looked useless."

# game/scenes/adventure_chapter2.rpy:92
translate english adv_chapter2_56d1f8a1:

    # narrator "Lepas tu dia nampak: kain tertarik ketat di bahagian kaki."
    narrator "Then he saw it: the shroud pulled tight around the feet."

# game/scenes/adventure_chapter2.rpy:93
translate english adv_chapter2_41c6f4a9:

    # narrator "Dalam satu bingkai kabur, ada juga tanah basah melekat pada simpulan itu."
    narrator "In one blurred frame, wet soil clung to the knot."

# game/scenes/adventure_chapter2.rpy:94
translate english adv_chapter2_7e202adc:

    # narrator "Bukan sekadar benda muncul dari gelap. Macam ada kubur yang masih menariknya balik."
    narrator "This was not just something emerging from the dark. It was as if a grave was still dragging it back."

# game/scenes/adventure_chapter2.rpy:100
translate english adv_chapter2_b15c1cb1:

    # narrator "Dia perhati terlalu lama."
    narrator "He watched for too long."

# game/scenes/adventure_chapter2.rpy:102
translate english adv_chapter2_ef2a8914:

    # narrator "Jeritan tu masuk terus ke kepala."
    narrator "The scream went straight into his skull."

# game/scenes/adventure_chapter2.rpy:107
translate english adv_chapter2_34feaf10:

    # narrator "Aris terkaku."
    narrator "Aris froze."

# game/scenes/adventure_chapter2.rpy:108
translate english adv_chapter2_77f0bdce:

    # narrator "Jeritan tu buat dia jatuh tersungkur."
    narrator "The scream knocked him to the ground."

# game/scenes/adventure_chapter2.rpy:114
translate english adv_chapter2_608c1eb2:

    # villager_1 "Dia... dia datang ikut jalan yang sama."
    villager_1 "It... it comes along the same road."

# game/scenes/adventure_chapter2.rpy:115
translate english adv_chapter2_1da0a83a:

    # villager_1 "Malam-malam sebelum ni pun macam tu. Kalau orang lari, dia kejar."
    villager_1 "It was the same on the other nights. If people run, it chases them."

# game/scenes/adventure_chapter2.rpy:116
translate english adv_chapter2_3533a792:

    # villager_1 "Kalau semua tutup pintu, dia tunggu."
    villager_1 "If everyone shuts their doors, it waits."

# game/scenes/adventure_chapter2.rpy:117
translate english adv_chapter2_333002dc:

    # narrator "Lelaki tu bercakap sambil menggigil, tapi kata-katanya melekat dalam kepala Aris."
    narrator "The man spoke while trembling, but his words stuck in Aris's mind."

# game/scenes/adventure_chapter2.rpy:121
translate english adv_chapter2_8ee07ff6:

    # narrator "Pintu rumah di sekeliling tertutup rapat."
    narrator "The doors of the surrounding houses were shut tight."

# game/scenes/adventure_chapter2.rpy:122
translate english adv_chapter2_68f98f15:

    # narrator "Tak ada sesiapa berani keluar untuk tanya sama ada Aris masih hidup."
    narrator "No one dared come out to ask whether Aris was still alive."

# game/scenes/adventure_chapter2.rpy:123
translate english adv_chapter2_bb44d213:

    # narrator "Di Batu Layar, takut dah jadi bahasa harian."
    narrator "In Batu Layar, fear had become an everyday language."

# game/scenes/adventure_chapter2.rpy:125
translate english adv_chapter2_ceb1ef29:

    # narrator "Pocong tu berundur sebelum subuh."
    narrator "The creature withdrew before dawn."

# game/scenes/adventure_chapter2.rpy:126
translate english adv_chapter2_0a1d5d5a:

    # narrator "Bukan macam ia kalah."
    narrator "Not as if it had been defeated."

# game/scenes/adventure_chapter2.rpy:127
translate english adv_chapter2_4d8531cb:

    # narrator "Macam ia cuma terganggu."
    narrator "As if it had only been interrupted."

# game/scenes/adventure_chapter2.rpy:128
translate english adv_chapter2_7ac6be98:

    # narrator "Aris buka buku nota dengan tangan yang belum berhenti menggigil."
    narrator "Aris opened his notebook with hands that still had not stopped shaking."

# game/scenes/adventure_chapter2.rpy:129
translate english adv_chapter2_2b90c468:

    # narrator "Serangan itu bukan rawak."
    narrator "The attack was not random."

# game/scenes/adventure_chapter2.rpy:130
translate english adv_chapter2_c370b1b6:

    # narrator "Ada laluan. Ada jeda. Ada simpulan."
    narrator "There was a path. A pause. A knot."

# game/scenes/adventure_chapter2.rpy:133
translate english adv_chapter2_634ba66f:

    # narrator "Telefon Hafiz masuk, skrin menyala dalam gelap."
    narrator "Hafiz called, the screen lighting up in the dark."

# game/scenes/adventure_chapter2.rpy:143
translate english adv_chapter2_1ba10a88:

    # hafiz "Aku nampak dari jauh. Kau masih boleh teruskan?"
    hafiz "I saw it from far away. Can you still keep going?"

# game/scenes/adventure_chapter2.rpy:144
translate english adv_chapter2_26f52fcf:

    # mc "Boleh. Tapi benda ni bukan kes serang dan habis."
    mc "Yes. But this isn't a case where we attack and it's over."

# game/scenes/adventure_chapter2.rpy:145
translate english adv_chapter2_d6c2dcb5:

    # hafiz "Jadi cari sebab dia masih ulang benda sama."
    hafiz "Then find out why it keeps repeating the same thing."

