    narrator "The shroud around his feet was pulled tight, as if the earth itself still refused to let him go."

# game/scenes/adventure_chapter5.rpy:22
translate english adv_chapter5_8b2ee0d8:

    # narrator "Kali ni, buku nota bukan sekadar catatan."
    narrator "This time, the notebook was more than a record."

# game/scenes/adventure_chapter5.rpy:23
translate english adv_chapter5_d540a8aa:

    # narrator "Setiap petunjuk mungkin jadi cara untuk terus hidup."
    narrator "Every clue might become a way to stay alive."

# game/scenes/adventure_chapter5.rpy:24
translate english adv_chapter5_9d35d039:

    # narrator "Aris teringat suara Mak Ros."
    narrator "Aris remembered Mak Ros's voice."

# game/scenes/adventure_chapter5.rpy:25
translate english adv_chapter5_36fabab3:

    # narrator "Jangan lari kalau mahu baca rentaknya."
    narrator "Do not run if you want to read its rhythm."

# game/scenes/adventure_chapter5.rpy:26
translate english adv_chapter5_562c9619:

    # narrator "Dia teringat tanah kubur yang tak rata."
    narrator "He remembered the uneven grave soil."

# game/scenes/adventure_chapter5.rpy:27
translate english adv_chapter5_4408aeb6:

    # narrator "Jangan potong kalau simpulan itu perlu dibuka."
    narrator "Do not cut what needs to be untied."

# game/scenes/adventure_chapter5.rpy:28
translate english adv_chapter5_7bdc3a46:

    # narrator "Dia teringat ibu tua itu."
    narrator "He remembered the old mother."

# game/scenes/adventure_chapter5.rpy:29
translate english adv_chapter5_9845bc9e:

    # narrator "Mulakan dengan nama dia."
    narrator "Begin with his name."

# game/scenes/adventure_chapter5.rpy:47
translate english adv_chapter5_c9ef2ee4:

    # narrator "Aris tahan diri daripada lari."
    narrator "Aris stopped himself from running."

# game/scenes/adventure_chapter5.rpy:48
translate english adv_chapter5_9f52905f:

    # narrator "Duk. Jeda. Duk. Jeda."
    narrator "Thud. Pause. Thud. Pause."

# game/scenes/adventure_chapter5.rpy:49
translate english adv_chapter5_2b2339f2:

    # narrator "Betul kata Mak Ros: bila Aris tak panik, gerak pocong tu boleh dibaca."
    narrator "Mak Ros was right: when Aris did not panic, the creature's movements could be read."

# game/scenes/adventure_chapter5.rpy:53
translate english adv_chapter5_8197f120:

    # narrator "Aris bergerak sedikit, cukup untuk pecahkan jeda itu."
    narrator "Aris moved a little, just enough to break the pause."

# game/scenes/adventure_chapter5.rpy:55
translate english adv_chapter5_decf6043:

    # narrator "Pocong tu melompat terlalu dekat sebelum Aris sempat tarik nafas."
    narrator "The creature hopped too close before Aris could draw breath."

# game/scenes/adventure_chapter5.rpy:61
translate english adv_chapter5_7a4c2713:

    # narrator "Cahaya lampu jatuh tepat pada simpulan kain di kakinya."
    narrator "The light fell directly on the shroud knots at its feet."

# game/scenes/adventure_chapter5.rpy:62
translate english adv_chapter5_b73d1d3d:

    # narrator "Bukan sekadar serangan. Ada sesuatu yang masih terikat."
    narrator "This was not just an attack. Something was still bound."

# game/scenes/adventure_chapter5.rpy:67
translate english adv_chapter5_509c5f84:

    # narrator "Cahaya lampu terkena kain putih, tapi Aris belum faham apa yang patut dicari."
    narrator "The light struck the shroud, but Aris still did not understand what he should be looking for."

# game/scenes/adventure_chapter5.rpy:68
translate english adv_chapter5_785fc948:

    # narrator "Pocong tu menghentam tanah terlalu dekat."
    narrator "The creature slammed into the ground too close."

# game/scenes/adventure_chapter5.rpy:73
translate english adv_chapter5_a8916631:

    # narrator "Aris mengangkat keris sebelum sempat menyebut nama arwah."
    narrator "Aris raised the keris before he could speak the dead man's name."

# game/scenes/adventure_chapter5.rpy:74
translate english adv_chapter5_ab6ca7f4:

    # narrator "Pocong tu menggigil, lebih marah daripada takut."
    narrator "The creature trembled, more angry than afraid."

# game/scenes/adventure_chapter5.rpy:80
translate english adv_chapter5_497bf440:

    # narrator "Aris hampir terkaku."
    narrator "Aris nearly froze."

# game/scenes/adventure_chapter5.rpy:81
translate english adv_chapter5_0a7143ae:

    # narrator "Tapi dia teringat satu benda: jangan lari."
    narrator "But he remembered one thing: do not run."

# game/scenes/adventure_chapter5.rpy:82
translate english adv_chapter5_57cf5f1a:

    # narrator "Dia diam dengan sengaja, dan pocong tu hilang rentak sekejap."
    narrator "He stayed still on purpose, and the creature lost its rhythm for a moment."

# game/scenes/adventure_chapter5.rpy:87
translate english adv_chapter5_d40a451b:

    # narrator "Aris bergerak tanpa membaca rentaknya."
    narrator "Aris moved without reading its rhythm."

# game/scenes/adventure_chapter5.rpy:89
translate english adv_chapter5_82d0d8f8:

    # narrator "Bahu dia terkena hentaman kain dan tulang."
    narrator "His shoulder was struck by shroud and bone."

# game/scenes/adventure_chapter5.rpy:106
translate english adv_chapter5_28c05fd3:

    # mc "Azlan."
    mc "Azlan."

# game/scenes/adventure_chapter5.rpy:107
translate english adv_chapter5_790aabe7:

    # mc "Aku tahu kau abang Melur."
    mc "I know you're Melur's brother."

# game/scenes/adventure_chapter5.rpy:108
translate english adv_chapter5_3ab83c1b:

    # mc "Ibu kau masih ingat. Dia tak pernah buang nama kau."
    mc "Your mother still remembers. She never threw your name away."

# game/scenes/adventure_chapter5.rpy:109
translate english adv_chapter5_7f5c5512:

    # mc "Orang kampung padam nama tu sebab mereka takut dengan salah sendiri."
    mc "The villagers erased that name because they were afraid of their own guilt."

# game/scenes/adventure_chapter5.rpy:110
translate english adv_chapter5_901ef249:

    # narrator "Kain putih tu tak lagi bergerak macam benda yang diburu."
    narrator "The shrouded figure no longer moved like something being hunted."

# game/scenes/adventure_chapter5.rpy:111
translate english adv_chapter5_b1fc91df:

    # narrator "Ia bergerak seperti orang yang akhirnya didengar."
    narrator "It moved like someone finally being heard."

# game/scenes/adventure_chapter5.rpy:117
translate english adv_chapter5_addfdcdb:

    # narrator "Aris buka surat lama dengan tangan yang menggigil."
    narrator "Aris opened the old letter with trembling hands."

# game/scenes/adventure_chapter5.rpy:118
translate english adv_chapter5_8b523ed4:

    # mc "Azlan, kau mati bukan sebab bawa bala."
    mc "Azlan, you didn't die because you brought a curse."

# game/scenes/adventure_chapter5.rpy:119
translate english adv_chapter5_e1f49c71:

    # mc "Kau mati sebab hentikan bomoh yang kampung ni takut nak sebut."
    mc "You died because you stopped the bomoh this village is afraid to name."

# game/scenes/adventure_chapter5.rpy:120
translate english adv_chapter5_2f8353c9:

    # mc "Anak kau masih ada. Dia berhak tahu bapanya bukan punca bala."
    mc "Your child is still here. He deserves to know his father was not the source of the curse."

# game/scenes/adventure_chapter5.rpy:121
translate english adv_chapter5_02e01ce0:

    # mc "Surat kau tak patut tinggal dalam kotak sampai reput."
    mc "Your letter should not have been left to rot in a box."

# game/scenes/adventure_chapter5.rpy:122
translate english adv_chapter5_b1ff307c:

    # narrator "Tanah kubur tu senyap, seolah-olah ayat itu sudah lama tunggu untuk dibaca."
    narrator "The grave soil was silent, as if those words had been waiting a long time to be read."

# game/scenes/adventure_chapter5.rpy:127
translate english adv_chapter5_c75fe9d2:

    # narrator "Doa itu menahan takut dalam dada Aris, tapi doa itu tak memanggil dia dengan namanya."
    narrator "The prayer held back the fear in Aris's chest, but it did not call him by name."

# game/scenes/adventure_chapter5.rpy:128
translate english adv_chapter5_bb663246:

    # narrator "Pocong tu masih tak tahu sama ada Aris datang untuk faham, atau untuk hukum."
    narrator "The creature still did not know whether Aris had come to understand or to punish."

# game/scenes/adventure_chapter5.rpy:133
translate english adv_chapter5_4ed35755:

    # narrator "Aris buka ruang dengan keris."
    narrator "Aris opened space with the keris."

# game/scenes/adventure_chapter5.rpy:134
translate english adv_chapter5_97bfbf9d:

    # narrator "Untuk sekejap, pocong tu tunduk."
    narrator "For a moment, the creature bowed."

# game/scenes/adventure_chapter5.rpy:135
translate english adv_chapter5_d5d49050:

    # narrator "Tapi tunduk bukan sama dengan reda."
    narrator "But bowing was not the same as being at peace."

# game/scenes/adventure_chapter5.rpy:141
translate english adv_chapter5_059cec6a:

    # narrator "Aris tunggu terlalu lama."
    narrator "Aris waited too long."

# game/scenes/adventure_chapter5.rpy:142
translate english adv_chapter5_f84bfcbd:

    # narrator "Tanpa nama, senyap itu cuma jadi satu lagi cara meninggalkan dia."
    narrator "Without a name, that silence became just another way of abandoning him."

# game/scenes/adventure_chapter5.rpy:145
translate english adv_chapter5_c93a3718:

    # narrator "Simpulan di kaki pocong itu menegang."
    narrator "The knot at the creature's feet tightened."

# game/scenes/adventure_chapter5.rpy:146
translate english adv_chapter5_d5cb3b8c:

    # narrator "Benang kafan dalam beg Aris terasa ringan, tapi maknanya makin berat."
    narrator "The shroud thread in Aris's bag felt light, but its meaning grew heavier."

# game/scenes/adventure_chapter5.rpy:147
translate english adv_chapter5_ca354a3d:

    # narrator "Ini bukan lagi soalan tentang cara menang."
    narrator "This was no longer a question of how to win."

# game/scenes/adventure_chapter5.rpy:148
translate english adv_chapter5_d29d97bc:

    # narrator "Ini soalan sama ada Aris cukup berani untuk dekat tanpa niat nak hukum."
    narrator "It was a question of whether Aris was brave enough to come close without intending to punish."

# game/scenes/adventure_chapter5.rpy:170
translate english adv_chapter5_f852258c:

    # narrator "Aris berhenti sekejap dan ingat semula semua petunjuk yang dia kumpul."
    narrator "Aris stopped for a moment and remembered every clue he had gathered."

# game/scenes/adventure_chapter5.rpy:171
translate english adv_chapter5_5480236f:

    # narrator "Nama. Simpulan. Tasbih. Bukan senjata."
    narrator "Name. Knot. Tasbih. Not a weapon."

# game/scenes/adventure_chapter5.rpy:176
translate english adv_chapter5_dc304205:

    # narrator "Aris nampak simpulan itu, tapi dia belum cukup faham cara membukanya."
    narrator "Aris saw the knot, but he still did not understand enough to untie it."

# game/scenes/adventure_chapter5.rpy:177
translate english adv_chapter5_ca320d00:

    # narrator "Faham separuh jalan pun boleh melukakan."
    narrator "Half-understanding can still wound."

# game/scenes/adventure_chapter5.rpy:182
translate english adv_chapter5_255f543f:

    # narrator "Aris cuba membuka simpulan itu."
    narrator "Aris tried to untie the knot."

# game/scenes/adventure_chapter5.rpy:183
