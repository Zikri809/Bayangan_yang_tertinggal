# game/scenes/adventure_chapter5.rpy:205
translate english adv_chapter5_e89e6837:

    # narrator "Aris terkaku di depan simpulan terakhir."
    narrator "Aris froze before the final knot."

# game/scenes/adventure_chapter5.rpy:216
translate english adv_release_ending_41542ed0:

    # narrator "Aris turunkan keris."
    narrator "Aris lowered the keris."

# game/scenes/adventure_chapter5.rpy:217
translate english adv_release_ending_28c05fd3:

    # mc "Azlan."
    mc "Azlan."

# game/scenes/adventure_chapter5.rpy:218
translate english adv_release_ending_986032cc:

    # mc "Aku tahu siapa kau."
    mc "I know who you are."

# game/scenes/adventure_chapter5.rpy:219
translate english adv_release_ending_7497fa3d:

    # mc "Melur ingat kau. Ibu kau ingat kau."
    mc "Melur remembers you. Your mother remembers you."

# game/scenes/adventure_chapter5.rpy:220
translate english adv_release_ending_47df9995:

    # mc "Anak kau masih ada, dan cerita sebenar kau tak patut tertanam lagi."
    mc "Your child is still here, and your true story should not stay buried any longer."

# game/scenes/adventure_chapter5.rpy:221
translate english adv_release_ending_3f6a1ed3:

    # mc "Dia hidup lama dengan cerita yang salah. Lepas malam ni, itu tak patut jadi warisan dia."
    mc "He has lived too long with the wrong story. After tonight, that should not be his inheritance."

