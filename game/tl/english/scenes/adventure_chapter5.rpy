    # narrator "Aris teringat anak Azlan, dan rasa pahit itu datang lambat: ada kebenaran yang masih belum cukup berani dia bawa pulang."
    narrator "Aris remembered Azlan's child, and the bitterness came late: there was a truth he still had not been brave enough to bring home."

# game/scenes/adventure_chapter5.rpy:289
translate english adv_ignorance_ending_e196eb08:

    # narrator "Hafiz jumpa Aris di tepi jalan sebelum subuh."
    narrator "Hafiz found Aris by the roadside before dawn."

# game/scenes/adventure_chapter5.rpy:290
translate english adv_ignorance_ending_478251a3:

    # hafiz "Dia dah lepas?"
    hafiz "Has he been released?"

# game/scenes/adventure_chapter5.rpy:291
translate english adv_ignorance_ending_cb348420:

    # narrator "Aris tak mampu jawab dengan yakin."
