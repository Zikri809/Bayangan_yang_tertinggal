    # narrator "Tasbih ada di tangannya, tapi hati Aris masih belum pasti siapa yang sedang dia lepaskan."
    narrator "The tasbih was in his hand, but Aris's heart still was not sure whom he was releasing."

# game/scenes/adventure_chapter5.rpy:188
translate english adv_chapter5_f7bd16c6:

    # narrator "Garam menyentuh kain kafan."
    narrator "Salt touched the burial shroud."

# game/scenes/adventure_chapter5.rpy:189
