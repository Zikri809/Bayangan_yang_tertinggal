    # mc "Malam ni, aku buka simpulan tu."
    mc "Tonight, I will untie that knot."

# game/scenes/adventure_chapter5.rpy:227
translate english adv_release_ending_113050b7:

    # narrator "Pocong tu tak tunduk."
    narrator "The creature did not bow."

# game/scenes/adventure_chapter5.rpy:228
translate english adv_release_ending_c111406b:

    # narrator "Ia berhenti."
    narrator "It stopped."

# game/scenes/adventure_chapter5.rpy:229
translate english adv_release_ending_2c46e12c:

    # narrator "Beza itu kecil, tapi Aris rasa seluruh malam berubah."
    narrator "The difference was small, but Aris felt the whole night change."

# game/scenes/adventure_chapter5.rpy:230
translate english adv_release_ending_fa4ab341:

    # narrator "Aris melangkah satu tapak."
    narrator "Aris took one step."

# game/scenes/adventure_chapter5.rpy:231
translate english adv_release_ending_1b1bdc99:

    # narrator "Duk."
    narrator "Thud."

# game/scenes/adventure_chapter5.rpy:232
translate english adv_release_ending_a5a5cf63:

    # narrator "Pocong tu menggigil."
    narrator "The creature trembled."

# game/scenes/adventure_chapter5.rpy:233
translate english adv_release_ending_b22a9365:

    # narrator "Aris berhenti, ikut jeda yang dia belajar dari Mak Ros."
    narrator "Aris stopped, following the pause he had learned from Mak Ros."

# game/scenes/adventure_chapter5.rpy:234
translate english adv_release_ending_5c6b9da7:

    # narrator "Bila kain putih tu diam semula, dia melangkah lagi."
    narrator "When the shrouded figure went still again, he took another step."

# game/scenes/adventure_chapter5.rpy:235
translate english adv_release_ending_aa8bf1ed:

    # narrator "Tasbih bergerak perlahan di jari Aris."
    narrator "The tasbih moved slowly through Aris's fingers."

# game/scenes/adventure_chapter5.rpy:236
translate english adv_release_ending_c15480f8:

    # narrator "Setiap butir bantu dia jangan panik."
    narrator "Each bead helped him not to panic."

# game/scenes/adventure_chapter5.rpy:237
translate english adv_release_ending_3ec054e5:

    # narrator "Surat Azlan berada dalam buku nota, terbuka pada nama yang akhirnya disebut dengan betul."
    narrator "Azlan's letter lay in the notebook, open at the name that had finally been spoken properly."

# game/scenes/adventure_chapter5.rpy:238
translate english adv_release_ending_77086a93:

    # narrator "Benang kafan yang Aris jumpa di kubur diletakkan dekat simpulan lama tu."
