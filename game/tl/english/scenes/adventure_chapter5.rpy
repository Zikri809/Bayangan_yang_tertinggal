# game/scenes/adventure_chapter5.rpy:239
translate english adv_release_ending_16b011c7:

    # narrator "Bukan sebab benang itu sakti."
    narrator "Not because the thread was magical."

# game/scenes/adventure_chapter5.rpy:240
translate english adv_release_ending_53b96975:

    # narrator "Tapi sebab dari situlah masalahnya bermula."
    narrator "But because that was where the trouble had begun."

# game/scenes/adventure_chapter5.rpy:241
translate english adv_release_ending_e0534a98:

    # narrator "Simpulan lama tu melawan sekejap, kemudian longgar."
    narrator "The old knot resisted for a moment, then loosened."

# game/scenes/adventure_chapter5.rpy:242
translate english adv_release_ending_8fb8b6cd:

    # narrator "Tanah di bawah kaki Aris terasa bernafas keluar."
    narrator "The ground beneath Aris's feet seemed to breathe out."

# game/scenes/adventure_chapter5.rpy:243
translate english adv_release_ending_edda2586:

    # narrator "Kain putih tu akhirnya diam."
    narrator "The shrouded figure was finally still."

# game/scenes/adventure_chapter5.rpy:246
translate english adv_release_ending_191c04b4:

    # azlan "Terima kasih."
    azlan "Thank you."

# game/scenes/adventure_chapter5.rpy:247
translate english adv_release_ending_d4bd044f:

    # azlan "Jaga anak saya."
    azlan "Look after my child."

# game/scenes/adventure_chapter5.rpy:249
translate english adv_release_ending_0847be65:

    # mc "Saya akan pastikan anak kau dengar cerita yang betul."
    mc "I'll make sure your child hears the true story."

# game/scenes/adventure_chapter5.rpy:250
translate english adv_release_ending_9bb93f41:

    # narrator "Janji itu terasa lebih berat daripada benang kafan di tangan Aris."
    narrator "That promise felt heavier than the shroud thread in Aris's hand."

# game/scenes/adventure_chapter5.rpy:251
translate english adv_release_ending_c1ac6706:

    # narrator "Suara tu perlahan."
    narrator "The voice was soft."

# game/scenes/adventure_chapter5.rpy:252
translate english adv_release_ending_b4c9d7a1:

    # narrator "Tapi untuk pertama kali malam itu, ia bukan jeritan."
    narrator "But for the first time that night, it was not a scream."

# game/scenes/adventure_chapter5.rpy:257
translate english adv_release_ending_ee657658:

    # narrator "Dia pergi perlahan-lahan, macam akhirnya dibenarkan pergi."
    narrator "He left slowly, as if finally allowed to go."

# game/scenes/adventure_chapter5.rpy:259
translate english adv_release_ending_04029d77:

    # narrator "Di luar kampung, Hafiz masih menunggu dengan enjin kereta yang hampir mati."
    narrator "Outside the village, Hafiz was still waiting with the car engine nearly dead."

# game/scenes/adventure_chapter5.rpy:260
translate english adv_release_ending_b7d9febd:

    # hafiz "Kau berjaya?"
    hafiz "Did you do it?"

# game/scenes/adventure_chapter5.rpy:261
translate english adv_release_ending_f26b9c5a:

    # mc "Dia yang berjaya pergi. Kita cuma kena pastikan cerita dia sampai."
    mc "He was the one who managed to leave. We just have to make sure his story reaches people."

# game/scenes/adventure_chapter5.rpy:268
translate english adv_release_ending_2759cf26:

    # narrator "Melepaskan bukan sama dengan melupakan."
    narrator "Releasing is not the same as forgetting."

# game/scenes/adventure_chapter5.rpy:269
translate english adv_release_ending_86fb58dc:

    # narrator "Kadang-kadang, itulah cara paling jujur untuk menjaga orang yang masih hidup."
    narrator "Sometimes, it is the most honest way to care for the living."

# game/scenes/adventure_chapter5.rpy:279
translate english adv_ignorance_ending_4b9c3ac1:

    # narrator "Aris pilih cara yang buat pocong tu tunduk."
    narrator "Aris chose the method that made the creature bow."

# game/scenes/adventure_chapter5.rpy:281
translate english adv_ignorance_ending_4900ed1b:

    # narrator "Aris cuba buat benda yang betul, tapi petunjuk di tangannya belum cukup."
    narrator "Aris tried to do the right thing, but the clues in his hands were not enough."

# game/scenes/adventure_chapter5.rpy:283
translate english adv_ignorance_ending_a5c2eff6:

    # narrator "Pocong tu menjerit, tubuhnya melipat, lalu jatuh."
    narrator "The creature screamed, its body folding before it fell."

# game/scenes/adventure_chapter5.rpy:284
translate english adv_ignorance_ending_88499a06:

    # narrator "Kampung jadi senyap."
    narrator "The village fell silent."

# game/scenes/adventure_chapter5.rpy:285
translate english adv_ignorance_ending_97ad4e1c:

    # narrator "Tapi senyap tak semestinya tenang."
    narrator "But silence does not always mean peace."

# game/scenes/adventure_chapter5.rpy:287
