# game/scenes/adventure_chapter4.rpy:11
translate english adv_chapter4_db9b817a:

    # narrator "Matahari mula tenggelam di belakang Batu Layar."
    narrator "The sun began to sink behind Batu Layar."

# game/scenes/adventure_chapter4.rpy:12
translate english adv_chapter4_12d832a7:

    # narrator "Aris susun semua barang dari beg kecilnya."
    narrator "Aris laid out everything from his small bag."

# game/scenes/adventure_chapter4.rpy:15
translate english adv_chapter4_3e6800d7:

    # narrator "Buku nota itu bukan lagi senarai petunjuk."
    narrator "The notebook was no longer just a list of clues."

# game/scenes/adventure_chapter4.rpy:16
translate english adv_chapter4_72b0ccc6:

    # narrator "Ia mula nampak macam peta salah orang hidup."
    narrator "It had begun to look like a map of mistakes made by the living."

# game/scenes/adventure_chapter4.rpy:17
translate english adv_chapter4_e3c1a167:

    # narrator "Satu halaman untuk gerak pocong."
    narrator "One page for the creature's movements."

# game/scenes/adventure_chapter4.rpy:18
translate english adv_chapter4_042c4d86:

    # narrator "Satu halaman untuk kubur yang dibuat tergesa-gesa."
    narrator "One page for the grave dug in haste."

# game/scenes/adventure_chapter4.rpy:19
translate english adv_chapter4_b5b943be:

    # narrator "Satu halaman untuk nama Azlan."
    narrator "One page for Azlan's name."

# game/scenes/adventure_chapter4.rpy:22
translate english adv_chapter4_cbea36cb:

    # narrator "Telefon Hafiz masuk sekejap: dia masih tunggu di luar kampung, siap kalau Aris perlu keluar cepat."
    narrator "Hafiz called briefly: he was still waiting outside the village, ready if Aris needed to get out fast."

# game/scenes/adventure_chapter4.rpy:25
translate english adv_chapter4_3d88dfa0:

    # narrator "Lelaki yang Aris bantu semalam tinggalkan air dan kain bersih dekat pintu. Tak ada ucapan, cuma tanda dia masih hidup."
    narrator "The man Aris had helped last night left water and clean cloth by the door. No words, only a sign that he was still alive."

# game/scenes/adventure_chapter4.rpy:29
translate english adv_chapter4_c421dabe:

    # narrator "Benang kafan. Surat lama. Tasbih."
    narrator "A shroud thread. An old letter. A tasbih."

# game/scenes/adventure_chapter4.rpy:30
translate english adv_chapter4_ec3fce1d:

    # narrator "Kali ni, semua petunjuk bawa Aris ke satu arah: melepaskan, bukan melawan."
    narrator "This time, every clue led Aris in one direction: release, not resistance."

# game/scenes/adventure_chapter4.rpy:31
translate english adv_chapter4_2b9061cc:

    # narrator "Masalahnya, faham waktu senja belum tentu cukup bila benda tu melompat tepat depan mata."
    narrator "The problem was that understanding at dusk might not be enough when that thing hopped right in front of him."

# game/scenes/adventure_chapter4.rpy:32
translate english adv_chapter4_faab2edb:

    # narrator "Malam nanti, nota lengkap belum cukup. Aris masih kena ikut rentak, sebut nama Azlan, dan dekat tanpa memaksa."
    narrator "Tonight, complete notes would not be enough. Aris still had to follow its rhythm, speak Azlan's name, and come close without force."

# game/scenes/adventure_chapter4.rpy:34
translate english adv_chapter4_886fe83c:

    # narrator "Dia ada cukup barang untuk hidup."
    narrator "He had enough tools to survive."

# game/scenes/adventure_chapter4.rpy:35
translate english adv_chapter4_e9781a79:

    # narrator "Mungkin belum cukup untuk faham."
    narrator "Maybe not enough to understand."

# game/scenes/adventure_chapter4.rpy:36
translate english adv_chapter4_e5ef444a:

    # narrator "Dan untuk kes macam ni, hidup saja mungkin bukan menang."
    narrator "And for a case like this, merely surviving might not be a victory."

# game/scenes/adventure_chapter4.rpy:40
translate english adv_chapter4_ff562825:

    # narrator "Aris biarkan keris dalam sarung."
    narrator "Aris left the keris in its sheath."

# game/scenes/adventure_chapter4.rpy:41
translate english adv_chapter4_e7cc8f3e:

    # narrator "Tasbih dililit di pergelangan tangan."
    narrator "The tasbih was wrapped around his wrist."

# game/scenes/adventure_chapter4.rpy:42
translate english adv_chapter4_9178d875:

    # narrator "Surat Azlan dilipat dan diselitkan dalam buku nota, dekat dengan benang kafan."
    narrator "Azlan's letter was folded and tucked into the notebook, near the shroud thread."

# game/scenes/adventure_chapter4.rpy:43
translate english adv_chapter4_818f14d2:

    # narrator "Kalau tangan Aris menggigil nanti, sekurang-kurangnya dia tahu kenapa dia datang sini."
    narrator "If Aris's hands shook later, at least he would know why he had come here."

# game/scenes/adventure_chapter4.rpy:48
translate english adv_chapter4_2652d187:

    # narrator "Aris pegang keris dekat tangan."
    narrator "Aris kept the keris close at hand."

# game/scenes/adventure_chapter4.rpy:49
translate english adv_chapter4_1c9a8953:

    # narrator "Bila takut, rancangan paling kasar pun rasa paling selamat."
    narrator "When fear takes hold, even the roughest plan can feel the safest."

# game/scenes/adventure_chapter4.rpy:50
translate english adv_chapter4_851662b0:

    # narrator "Tapi makin lama bilah tu ada di tangan, makin senang lupa yang Azlan pernah jadi manusia."
    narrator "But the longer the blade stayed in his hand, the easier it became to forget that Azlan had once been human."

# game/scenes/adventure_chapter4.rpy:52
translate english adv_chapter4_34dc2aad:

    # narrator "Semua petunjuk masih ada, tapi pilihan itu buat jalan melepaskan dia jadi rapuh sebelum bermula."
    narrator "All the clues were still there, but that choice made the path to release him fragile before it even began."

# game/scenes/adventure_chapter4.rpy:57
translate english adv_chapter4_f17087c1:

    # narrator "Aris tengok jalan keluar dari kampung."
    narrator "Aris looked toward the road out of the village."

# game/scenes/adventure_chapter4.rpy:58
translate english adv_chapter4_8238840e:

    # narrator "Fikiran itu terasa pahit."
    narrator "The thought tasted bitter."

# game/scenes/adventure_chapter4.rpy:59
translate english adv_chapter4_f64bfec4:

    # narrator "Ada beza antara hidup untuk sambung siasatan, dengan lari sebab tak mahu faham."
    narrator "There was a difference between living to continue the investigation and running because he did not want to understand."

# game/scenes/adventure_chapter4.rpy:61
translate english adv_chapter4_7d2bdf9d:

    # narrator "Nota mungkin lengkap, tapi niat untuk lari boleh buat Aris gagal mendekat bila simpulan perlu dibuka."
    narrator "The notes might be complete, but the urge to run could keep Aris from drawing close when the knot had to be untied."

# game/scenes/adventure_chapter4.rpy:79
translate english adv_chapter4_8e1aadec:

    # narrator "Cahaya lampu suluh jatuh pada kain dan simpulan di kakinya."
    narrator "The flashlight beam fell on the shroud and the knots at its feet."

# game/scenes/adventure_chapter4.rpy:80
translate english adv_chapter4_a44436b5:

    # narrator "Pocong tu berhenti, macam baru pertama kali ada orang nampak dia betul-betul."
    narrator "The shrouded creature stopped, as if someone had truly seen him for the first time."

# game/scenes/adventure_chapter4.rpy:81
translate english adv_chapter4_98999125:

    # narrator "Bukan macam cerita seram."
    narrator "Not like a horror story."

# game/scenes/adventure_chapter4.rpy:82
translate english adv_chapter4_86cbb546:

    # narrator "Tapi macam seseorang yang ditinggalkan dalam keadaan salah."
    narrator "But like someone left in a state that was wrong."

# game/scenes/adventure_chapter4.rpy:86
translate english adv_chapter4_5840b481:

    # narrator "Doa tu menenangkan tangan Aris."
    narrator "The prayer steadied Aris's hands."

# game/scenes/adventure_chapter4.rpy:87
translate english adv_chapter4_38cda3d7:

    # narrator "Pocong tu menggigil, tapi tak menyerang."
    narrator "The creature trembled, but did not attack."

# game/scenes/adventure_chapter4.rpy:88
translate english adv_chapter4_3363c82d:

    # narrator "Untuk beberapa saat, bunyi duk di jalan kampung berhenti."
    narrator "For a few seconds, the thudding on the village road stopped."

# game/scenes/adventure_chapter4.rpy:89
translate english adv_chapter4_a47ac743:

    # narrator "Senyap tu tak aman, tapi ia bagi ruang."
    narrator "The silence was not peaceful, but it gave him room."

# game/scenes/adventure_chapter4.rpy:93
translate english adv_chapter4_aff360ed:

    # narrator "Garam bertabur di atas jalan."
    narrator "Salt scattered across the road."

# game/scenes/adventure_chapter4.rpy:94
translate english adv_chapter4_2a559359:

    # narrator "Pocong tu tersentak ke belakang."
    narrator "The creature jerked backward."

# game/scenes/adventure_chapter4.rpy:95
translate english adv_chapter4_93791504:

    # narrator "Nampak macam dia sakit, bukan sekadar terhalang."
    narrator "It looked as if he was in pain, not merely blocked."

# game/scenes/adventure_chapter4.rpy:97
translate english adv_chapter4_ebc5be05:

    # narrator "Aris rasa ruang untuk melepaskan Azlan makin sempit."
    narrator "Aris felt the chance to release Azlan growing narrower."

# game/scenes/adventure_chapter4.rpy:102
translate english adv_chapter4_53672836:

    # narrator "Bilah keris diangkat."
    narrator "The keris blade rose."

# game/scenes/adventure_chapter4.rpy:103
translate english adv_chapter4_61a92754:

    # narrator "Makhluk tu menjerit."
    narrator "The creature screamed."

# game/scenes/adventure_chapter4.rpy:105
translate english adv_chapter4_f1593818:

    # narrator "Semua jawapan dalam buku nota terasa jauh bila malam dibuka dengan bilah."
    narrator "Every answer in the notebook felt distant when the night began with a blade."

# game/scenes/adventure_chapter4.rpy:115
translate english adv_chapter4_f87182ce:

    # narrator "Aris ingat kata Mak Ros."
    narrator "Aris remembered Mak Ros's words."

# game/scenes/adventure_chapter4.rpy:116
translate english adv_chapter4_b6ff8278:

    # narrator "Dia berdiri diam, bukan sebab takut, tapi sebab dia faham rentak benda tu."
    narrator "He stood still, not because he was afraid, but because he understood the thing's rhythm."

# game/scenes/adventure_chapter4.rpy:117
translate english adv_chapter4_f608d4d8:

    # narrator "Untuk satu detik, pocong tu pun diam."
    narrator "For one instant, the creature was still too."

# game/scenes/adventure_chapter4.rpy:120
translate english adv_chapter4_f8fb83f6:

    # narrator "Aris berdiri diam, tapi dia tak tahu kenapa itu patut berkesan."
    narrator "Aris stood still, but he did not know why it should work."

# game/scenes/adventure_chapter4.rpy:121
translate english adv_chapter4_a18caf33:

    # narrator "Ragu itu cukup untuk buat tubuhnya lambat bergerak."
    narrator "That doubt was enough to slow his body."

# game/scenes/adventure_chapter4.rpy:124
translate english adv_chapter4_37cbb111:

    # narrator "Aris tersentak sebelum jeda itu habis."
    narrator "Aris flinched before the pause ended."

# game/scenes/adventure_chapter4.rpy:125
translate english adv_chapter4_fb718c08:

    # narrator "Pocong tu menangkap gerakan kecil itu seperti jawapan."
    narrator "The creature seized on that small movement as if it were an answer."

# game/scenes/adventure_chapter4.rpy:127
translate english adv_chapter4_f09efcf8:

    # narrator "Hentaman kain dan tulang buat lutut Aris hampir jatuh."
    narrator "The strike of shroud and bone nearly dropped Aris to his knees."

# game/scenes/adventure_chapter4.rpy:132
translate english adv_chapter4_a57d91d8:

    # narrator "Aris hampir terkaku, tapi dia teringat jeda kecil dalam gerakan pocong tu."
    narrator "Aris almost froze, but he remembered the small pause in the creature's movement."

# game/scenes/adventure_chapter4.rpy:133
translate english adv_chapter4_c8abc159:

    # narrator "Dia diam dengan sengaja."
    narrator "He stayed still on purpose."

# game/scenes/adventure_chapter4.rpy:137
translate english adv_chapter4_87c62fbf:

    # narrator "Aris teragak-agak."
    narrator "Aris hesitated."

# game/scenes/adventure_chapter4.rpy:139
translate english adv_chapter4_086a409c:

    # narrator "Hentaman tu buat nafas dia putus sekejap."
    narrator "The impact knocked the breath out of him for a moment."

# game/scenes/adventure_chapter4.rpy:142
translate english adv_chapter4_9638a69b:

    # narrator "Malam belum selesai."
    narrator "The night was not over."

# game/scenes/adventure_chapter4.rpy:143
translate english adv_chapter4_3596d0dd:

    # narrator "Apa yang muncul di jalan tadi cuma amaran."
    narrator "What had appeared on the road was only a warning."

# game/scenes/adventure_chapter4.rpy:144
translate english adv_chapter4_0054a9d0:

    # narrator "Simpulan terakhir masih menunggu di kubur Azlan."
    narrator "The final knot still waited at Azlan's grave."

