# game/scenes/adventure_chapter3.rpy:13
translate english adv_chapter3_fe026af7:

    # narrator "Waktu siang buat Batu Layar nampak macam kampung biasa."
    narrator "In daylight, Batu Layar looked like an ordinary village."

# game/scenes/adventure_chapter3.rpy:14
translate english adv_chapter3_8f8a7885:

    # narrator "Itu yang buat rasa makin tak sedap."
    narrator "That only made it feel worse."

# game/scenes/adventure_chapter3.rpy:28
translate english adv_investigation_hub_665bf9b0:

    # narrator "Aris semak buku notanya."
    narrator "Aris checked his notebook."

# game/scenes/adventure_chapter3.rpy:29
translate english adv_investigation_hub_26bf1ef5:

    # narrator "Masih ada masa sebelum malam."
    narrator "There was still time before nightfall."

# game/scenes/adventure_chapter3.rpy:43
translate english adv_investigation_hub_483317e2:

    # narrator "Aris tengok buku notanya."
    narrator "Aris looked at his notebook."

# game/scenes/adventure_chapter3.rpy:44
translate english adv_investigation_hub_4f4f3262:

    # narrator "Masih ada benda yang belum lengkap: gerak-geri, identiti, atau cara melepaskan."
    narrator "Something was still incomplete: its movements, its identity, or the way to release it."

# game/scenes/adventure_chapter3.rpy:45
translate english adv_investigation_hub_d04348f0:

    # narrator "Kalau dia teruskan sekarang, mungkin dia cuma cukup bersedia untuk bertahan."
    narrator "If he continued now, he might only be prepared enough to survive."

# game/scenes/adventure_chapter3.rpy:62
translate english adv_mak_ros_house_5767e8e6:

    # mak_ros "Saya dengar bunyi tu dulu, sebelum benda tu sampai."
    mak_ros "I heard the sound first, before that thing arrived."

# game/scenes/adventure_chapter3.rpy:63
translate english adv_mak_ros_house_b6131306:

    # mak_ros "Macam orang menangis. Tapi jauh. Dalam kain."
    mak_ros "Like someone crying. But far away. Inside the shroud."

# game/scenes/adventure_chapter3.rpy:64
translate english adv_mak_ros_house_4049534a:

    # mak_ros "Saya dah lama tak tidur betul-betul."
    mak_ros "I haven't slept properly in a long time."

# game/scenes/adventure_chapter3.rpy:65
translate english adv_mak_ros_house_e0dfcb47:

    # mak_ros "Kalau terlelap pun, bunyi duk tu masuk mimpi dulu."
    mak_ros "Even when I doze off, that thud enters my dreams first."

# game/scenes/adventure_chapter3.rpy:66
translate english adv_mak_ros_house_8248a888:

    # mc "Malam Nayan mati, Mak Ros nampak apa?"
    mc "On the night Nayan died, what did you see, Mak Ros?"

# game/scenes/adventure_chapter3.rpy:67
translate english adv_mak_ros_house_4b55cc81:

    # mak_ros "Tak nampak jelas. Tapi saya tahu satu benda."
    mak_ros "I didn't see clearly. But I know one thing."

# game/scenes/adventure_chapter3.rpy:68
translate english adv_mak_ros_house_360a60bc:

    # mak_ros "Dia bukan cari Nayan dari awal. Nayan cuma bergerak masa benda tu lalu."
    mak_ros "It wasn't looking for Nayan from the start. Nayan only moved when that thing passed by."

# game/scenes/adventure_chapter3.rpy:73
translate english adv_mak_ros_house_bb927a5d:

    # narrator "Dalam kamera, bayang pucat lalu di jalan yang sama, berkali-kali."
    narrator "On the camera, a pale shadow passed along the same road again and again."

# game/scenes/adventure_chapter3.rpy:74
translate english adv_mak_ros_house_222e06cd:

    # narrator "Bila jalan kosong, bayang tu berhenti sekejap sebelum melompat lagi."
    narrator "When the road was empty, the shadow paused for a moment before hopping again."

# game/scenes/adventure_chapter3.rpy:80
translate english adv_mak_ros_house_a572f020:

    # mak_ros "Bunyi tu tak datang terus."
    mak_ros "The sound doesn't come all at once."

# game/scenes/adventure_chapter3.rpy:81
translate english adv_mak_ros_house_ed6db09d:

    # mak_ros "Ada jeda. Macam sesuatu dalam kain tu perlu kumpul tenaga sebelum melompat lagi."
    mak_ros "There's a pause. As if whatever is inside the shroud has to gather strength before it hops again."

# game/scenes/adventure_chapter3.rpy:82
translate english adv_mak_ros_house_59e26973:

    # mak_ros "Kalau orang lari, dia makin laju. Kalau orang diam, kadang-kadang dia berhenti."
    mak_ros "If people run, it gets faster. If people stay still, sometimes it stops."

# game/scenes/adventure_chapter3.rpy:88
translate english adv_mak_ros_house_2bdcffc5:

    # narrator "Calar tu bukan bekas kuku."
    narrator "The scratches were not claw marks."

# game/scenes/adventure_chapter3.rpy:89
translate english adv_mak_ros_house_c11ff4aa:

    # narrator "Macam kain dan tulang bergeser pada kayu."
    narrator "More like shroud and bone scraping against wood."

# game/scenes/adventure_chapter3.rpy:90
translate english adv_mak_ros_house_eba4e944:

    # narrator "Jarak calar tu tak sama. Ada ruang kosong, macam kesan lompatan yang selalu berhenti sekejap."
    narrator "The scratches were unevenly spaced. There were gaps, like the marks of hops that kept pausing."

# game/scenes/adventure_chapter3.rpy:95
translate english adv_mak_ros_house_70668880:

    # mak_ros "Nayan tak ada kena-mengena dengan dosa lama tu."
    mak_ros "Nayan had nothing to do with that old sin."

# game/scenes/adventure_chapter3.rpy:96
translate english adv_mak_ros_house_8604fa12:

    # mak_ros "Dia cuma lalu dekat laluan yang benda tu ulang setiap malam."
    mak_ros "He only passed near the path that thing repeats every night."

# game/scenes/adventure_chapter3.rpy:97
translate english adv_mak_ros_house_c6dbfed5:

    # mak_ros "Orang kampung suka cakap jangan keluar malam."
    mak_ros "The villagers like telling people not to go out at night."

# game/scenes/adventure_chapter3.rpy:98
translate english adv_mak_ros_house_6fcf50e3:

    # mak_ros "Tapi mereka jarang tanya kenapa benda tu masih berjalan di jalan yang sama."
    mak_ros "But they rarely ask why that thing still follows the same road."

# game/scenes/adventure_chapter3.rpy:118
translate english adv_burial_ground_aa8b5d27:

    # narrator "Kubur tu terletak jauh sikit daripada yang lain."
    narrator "The grave lay a little farther from the others."

# game/scenes/adventure_chapter3.rpy:119
translate english adv_burial_ground_0b77b3c5:

    # narrator "Namanya pun dah kabur. Kubur tu macam dijaga asal cukup syarat saja."
    narrator "Even the name had faded. The grave looked as if it had been tended only because someone had to."

# game/scenes/adventure_chapter3.rpy:120
translate english adv_burial_ground_debe8e41:

    # narrator "Tak ada rasa tenang."
    narrator "There was no sense of peace."

# game/scenes/adventure_chapter3.rpy:121
translate english adv_burial_ground_ae28d169:

    # narrator "Tanahnya tak rata, macam kerja yang dibuat cepat-cepat lepas tu semua orang pura-pura lupa."
    narrator "The earth was uneven, like work done in haste and then deliberately forgotten."

# game/scenes/adventure_chapter3.rpy:122
translate english adv_burial_ground_b2a4b547:

    # narrator "Kubur lain ada batu yang dibersihkan, rumput yang dipotong, bekas doa orang yang datang."
    narrator "Other graves had cleaned stones, trimmed grass, traces of prayers left by visitors."

# game/scenes/adventure_chapter3.rpy:123
translate english adv_burial_ground_160c2517:

    # narrator "Kubur ni cuma ada tanah berat dan kesan ditinggalkan."
    narrator "This grave had only heavy soil and the mark of abandonment."

# game/scenes/adventure_chapter3.rpy:124
translate english adv_burial_ground_2168138c:

    # narrator "Aris rasa macam berdiri depan rahsia yang sengaja dibiarkan reput."
    narrator "Aris felt as if he were standing before a secret left to rot on purpose."

# game/scenes/adventure_chapter3.rpy:126
translate english adv_burial_ground_3e89e6dc:

    # narrator "Dia angkat lampu suluh dan biarkan cahayanya bergerak perlahan atas tanah."
    narrator "He raised the flashlight and let its beam move slowly over the ground."

# game/scenes/adventure_chapter3.rpy:132
translate english adv_burial_ground_f3fb784f:

    # narrator "Lampu suluh nampakkan bekas gali lama."
    narrator "The flashlight revealed old digging marks."

# game/scenes/adventure_chapter3.rpy:133
translate english adv_burial_ground_c3317f76:

    # narrator "Bukan kerja yang dibuat dengan tertib."
    narrator "Not work done with care."

# game/scenes/adventure_chapter3.rpy:134
translate english adv_burial_ground_92186ff2:

    # narrator "Kerja orang yang nak cepat siap."
    narrator "The work of people who wanted it finished quickly."

# game/scenes/adventure_chapter3.rpy:140
translate english adv_burial_ground_73fdd541:

    # narrator "Aris tarik sehelai benang longgar dari tanah."
    narrator "Aris pulled a loose thread from the earth."

# game/scenes/adventure_chapter3.rpy:141
translate english adv_burial_ground_682faccd:

    # narrator "Kain kafan."
    narrator "A burial shroud."

# game/scenes/adventure_chapter3.rpy:142
translate english adv_burial_ground_7a026cb0:

    # narrator "Simpulannya masih ketat."
    narrator "Its knot was still tight."

# game/scenes/adventure_chapter3.rpy:149
translate english adv_burial_ground_1022a280:

    # narrator "Tulisan pada batu tu jadi jelas selepas beberapa saat."
    narrator "The writing on the stone became clear after a few seconds."

# game/scenes/adventure_chapter3.rpy:150
translate english adv_burial_ground_a7fa2cae:

    # narrator "Huruf yang pudar tu tersusun perlahan-lahan."
    narrator "The faded letters slowly arranged themselves."

# game/scenes/adventure_chapter3.rpy:151
translate english adv_burial_ground_35c14a8d:

    # narrator "AZLAN."
    narrator "AZLAN."

# game/scenes/adventure_chapter3.rpy:152
translate english adv_burial_ground_151210d0:

    # narrator "Lepas tu nama tu hilang balik bawah lumut dan tanah."
    narrator "Then the name disappeared again beneath moss and soil."

# game/scenes/adventure_chapter3.rpy:157
translate english adv_burial_ground_ff74f062:

    # narrator "Sebelum Aris berundur, lampu suluhnya menangkap sehelai benang putih tersangkut di bawah batu."
    narrator "Before Aris stepped back, his flashlight caught a pale thread snagged beneath the stone."

# game/scenes/adventure_chapter3.rpy:158
translate english adv_burial_ground_5f21b821:

    # narrator "Dia simpan benang kafan tu. Bukti kecil yang simpulan itu belum selesai."
    narrator "He kept the shroud thread. A small proof that the knot had not been settled."

# game/scenes/adventure_chapter3.rpy:163
translate english adv_burial_ground_c01f01bc:

    # narrator "Angin lalu perlahan di kawasan kubur."
    narrator "Wind passed softly through the graveyard."

# game/scenes/adventure_chapter3.rpy:164
translate english adv_burial_ground_cdc6f23b:

    # narrator "Benang kafan di tangan Aris terasa kering, tapi bau tanah basah masih melekat."
    narrator "The shroud thread in Aris's hand felt dry, but the smell of wet earth still clung to it."

# game/scenes/adventure_chapter3.rpy:165
translate english adv_burial_ground_b525b36b:

    # narrator "Buat pertama kali, kes ni tak terasa macam memburu benda seram."
    narrator "For the first time, this case did not feel like hunting a horror."

# game/scenes/adventure_chapter3.rpy:166
translate english adv_burial_ground_acded639:

    # narrator "Ia terasa macam membetulkan sesuatu yang orang hidup pernah rosakkan."
    narrator "It felt like repairing something the living had broken."

# game/scenes/adventure_chapter3.rpy:183
translate english adv_old_family_house_6f8dc6f3:

    # mother "Melur yang suruh kamu datang?"
    mother "Did Melur ask you to come?"

# game/scenes/adventure_chapter3.rpy:184
translate english adv_old_family_house_350bdd4b:

    # mc "Dia minta saya tolong abang dia."
    mc "She asked me to help her brother."

# game/scenes/adventure_chapter3.rpy:185
translate english adv_old_family_house_ef1e6150:

    # mother "Melur masih ingat rumah ni?"
    mother "Melur still remembers this house?"

# game/scenes/adventure_chapter3.rpy:186
translate english adv_old_family_house_5ae5c743:

    # mc "Dia ingat cukup untuk takut, tapi cukup juga untuk minta tolong."
    mc "She remembers enough to be afraid, but enough to ask for help too."

# game/scenes/adventure_chapter3.rpy:187
translate english adv_old_family_house_64deb1b8:

    # mother "Budak tu pergi sebab saya suruh dia pergi."
    mother "That child left because I told her to."

# game/scenes/adventure_chapter3.rpy:188
translate english adv_old_family_house_cb723e4b:

    # mother "Kalau dia tinggal, kampung ni akan telan dia sekali."
    mother "If she had stayed, this village would have swallowed her too."

# game/scenes/adventure_chapter3.rpy:190
translate english adv_old_family_house_cc66ffc7:

    # mother "Nama dia Azlan."
    mother "His name was Azlan."

# game/scenes/adventure_chapter3.rpy:191
translate english adv_old_family_house_93645671:

    # mother "Orang kampung ingat Azlan yang bawa bala."
    mother "The villagers thought Azlan brought the curse."

# game/scenes/adventure_chapter3.rpy:192
translate english adv_old_family_house_5890e77e:

    # mother "Mereka tak tahu dia mati sebab hentikan bala yang sebenar."
    mother "They didn't know he died stopping the real curse."

# game/scenes/adventure_chapter3.rpy:193
translate english adv_old_family_house_ea957ca3:

    # mother "Ada bomoh lama yang guna ketakutan kampung ni. Azlan hentikan dia, tapi orang cuma nampak dua mayat, lepas tu salahkan keluarga kami."
    mother "There was an old bomoh who used this village's fear. Azlan stopped him, but people only saw two bodies, then blamed our family."

# game/scenes/adventure_chapter3.rpy:194
translate english adv_old_family_house_109a3c49:

    # mother "Sebelum tu, ternakan mati, budak kecil demam tiba-tiba, orang balik meracau lepas jumpa bomoh tu malam-malam."
    mother "Before that, livestock died, little children suddenly fell ill, and people came home raving after meeting that bomoh at night."

# game/scenes/adventure_chapter3.rpy:195
translate english adv_old_family_house_4f5e7f6c:

    # mother "Azlan jumpa tempat dia buat kerja. Itu sebab bomoh tu cari dia dulu."
    mother "Azlan found the place where he did his work. That's why the bomoh came after him first."

# game/scenes/adventure_chapter3.rpy:196
translate english adv_old_family_house_2d4eb7c1:

    # mother "Azlan bukan orang alim besar. Dia cuma anak yang degil."
    mother "Azlan was no great holy man. He was just a stubborn son."

# game/scenes/adventure_chapter3.rpy:197
translate english adv_old_family_house_b339efb8:

    # mother "Tapi bila semua orang tutup pintu, dia yang keluar tengok apa sebenarnya jadi."
    mother "But when everyone else shut their doors, he was the one who went out to see what was really happening."

# game/scenes/adventure_chapter3.rpy:210
translate english adv_old_family_house_fe1ac05b:

    # narrator "Surat tu cerita tentang dia sebagai anak, suami, dan ayah."
    narrator "The letter told of him as a son, a husband, and a father."

# game/scenes/adventure_chapter3.rpy:211
translate english adv_old_family_house_db104643:

    # narrator "Surat tu juga ceritakan harga yang dia bayar untuk hentikan bomoh itu."
    narrator "It also told of the price he paid to stop the bomoh."

# game/scenes/adventure_chapter3.rpy:212
translate english adv_old_family_house_14b4ceb7:

    # narrator "Ayat terakhirnya bukan pasal mati."
    narrator "Its final line was not about death."

# game/scenes/adventure_chapter3.rpy:213
translate english adv_old_family_house_f4d31a74:

    # narrator "Ayat terakhirnya minta sesiapa yang jumpa surat tu jangan biarkan anaknya membesar dengan nama ayah yang dipijak."
    narrator "Its final line asked whoever found the letter not to let his child grow up with his father's name trampled underfoot."

# game/scenes/adventure_chapter3.rpy:222
translate english adv_old_family_house_d9d5ca67:

    # mother "Ambillah. Kalau kamu nak buka simpulan tu, jangan datang macam kamu nak hukum dia."
    mother "Take it. If you want to untie that knot, don't come as if you mean to punish him."

# game/scenes/adventure_chapter3.rpy:229
translate english adv_old_family_house_1dfa6a0e:

    # narrator "Ada sebungkus kecil garam dalam kabinet."
    narrator "There was a small packet of salt in the cabinet."

# game/scenes/adventure_chapter3.rpy:230
translate english adv_old_family_house_7fd32a8b:

    # narrator "Mungkin berguna kalau Aris cuma mahu hidup sampai subuh."
    narrator "It might be useful if Aris only wanted to live until dawn."

# game/scenes/adventure_chapter3.rpy:231
translate english adv_old_family_house_a154e8bb:

    # mother "Garam boleh buat dia berundur."
    mother "Salt can make him retreat."

# game/scenes/adventure_chapter3.rpy:232
translate english adv_old_family_house_e4121926:

    # mother "Tapi kalau kamu cuma mahu dia sakit, kamu takkan faham kenapa dia masih terikat."
    mother "But if all you want is to hurt him, you'll never understand why he is still bound."

# game/scenes/adventure_chapter3.rpy:233
translate english adv_old_family_house_b6650f17:

    # narrator "Pilihan tu terasa macam jalan orang yang takut, bukan orang yang sudah faham."
    narrator "That choice felt like the path of someone afraid, not someone who understood."

# game/scenes/adventure_chapter3.rpy:246
translate english adv_old_family_house_cb83f57e:

    # mother "Surat saja tak cukup. Tangan kamu pun kena tenang."
    mother "The letter alone isn't enough. Your hands must be steady too."

# game/scenes/adventure_chapter3.rpy:247
translate english adv_old_family_house_89dec407:

    # mother "Ambil tasbih ni. Kalau kamu sebut nama dia, sebut macam orang yang datang nak tolong."
    mother "Take this tasbih. If you say his name, say it like someone who has come to help."

# game/scenes/adventure_chapter3.rpy:254
translate english adv_old_family_house_464c5b8d:

    # mother "Dan satu lagi. Jangan bawa tasbih tu tanpa tahu siapa yang kamu doakan."
    mother "And one more thing. Don't carry that tasbih without knowing whom you're praying for."

# game/scenes/adventure_chapter3.rpy:259
translate english adv_old_family_house_629bd8e1:

    # narrator "Dia menyerahkan surat lama yang sudah berkali-kali dilipat."
    narrator "She handed over an old letter that had been folded many times."

# game/scenes/adventure_chapter3.rpy:260
translate english adv_old_family_house_d0cf5085:

    # narrator "Dalam surat tu, Azlan menulis tentang isterinya, anaknya, dan keputusan yang makan nyawanya."
    narrator "In that letter, Azlan wrote about his wife, his child, and the decision that cost him his life."

# game/scenes/adventure_chapter3.rpy:274
translate english adv_old_family_house_677ccef5:

    # mother "Mereka kebumikan dia cepat-cepat. Masa tu semua marah. Semua takut."
    mother "They buried him in a hurry. Everyone was angry then. Everyone was afraid."

# game/scenes/adventure_chapter3.rpy:275
translate english adv_old_family_house_af2ab6fa:

    # mother "Simpulan kafan tu tak pernah dibuka."
    mother "The knots in the burial shroud were never untied."

# game/scenes/adventure_chapter3.rpy:276
translate english adv_old_family_house_9fc4f5fb:

    # mother "Saya minta mereka berhenti sekejap."
    mother "I asked them to stop for a moment."

# game/scenes/adventure_chapter3.rpy:277
translate english adv_old_family_house_a4bf5ca0:

    # mother "Saya minta mereka sebut nama dia elok-elok."
    mother "I asked them to say his name properly."

# game/scenes/adventure_chapter3.rpy:278
translate english adv_old_family_house_bef610a4:

    # mother "Mereka kata jangan panjang-panjangkan bala lagi."
    mother "They said not to drag the curse out any longer."

# game/scenes/adventure_chapter3.rpy:282
translate english adv_old_family_house_6d02e235:

    # mother "Kalau kamu jumpa dia malam ni, jangan mulakan dengan keris."
    mother "If you meet him tonight, don't begin with the keris."

# game/scenes/adventure_chapter3.rpy:283
translate english adv_old_family_house_8f78ee86:

    # mother "Mulakan dengan nama dia."
    mother "Begin with his name."

# game/scenes/adventure_chapter3.rpy:284
translate english adv_old_family_house_26d48c06:

    # mother "Kalau Azlan masih dengar apa-apa, biar benda pertama yang sampai bukan takut."
    mother "If Azlan can still hear anything, let the first thing that reaches him be something other than fear."

