# game/scenes/adventure_prologue.rpy:13
translate english adv_prologue_db25dc73:

    # narrator "Nayan balik seorang diri malam tu."
    narrator "Nayan was walking home alone that night."

# game/scenes/adventure_prologue.rpy:14
translate english adv_prologue_8224f84c:

    # narrator "Malam di Kampung Batu Layar sunyi."
    narrator "Night in Kampung Batu Layar was silent."

# game/scenes/adventure_prologue.rpy:15
translate english adv_prologue_a872d68f:

    # narrator "Sunyi yang buat hati rasa tak sedap."
    narrator "The kind of silence that made your heart uneasy."

# game/scenes/adventure_prologue.rpy:16
translate english adv_prologue_49d6b20c:

    # narrator "Lampu rumah orang kampung masih ada yang menyala, tapi tak ada satu pun tingkap terbuka."
    narrator "Some of the village house lights were still on, but not a single window was open."

# game/scenes/adventure_prologue.rpy:17
translate english adv_prologue_2f0c986e:

    # narrator "Macam seluruh kampung sedang menahan nafas."
    narrator "It felt as if the whole village was holding its breath."

# game/scenes/adventure_prologue.rpy:18
translate english adv_prologue_603dce81:

    # narrator "Telefon Nayan bergetar sekali, kemudian skrin jadi gelap."
    narrator "Nayan's phone buzzed once, then the screen went dark."

# game/scenes/adventure_prologue.rpy:19
translate english adv_prologue_a741c86c:

    # narrator "Tak ada line."
    narrator "No signal."

# game/scenes/adventure_prologue.rpy:23
translate english adv_prologue_743b992f:

    # narrator "Yang ada cuma gelap."
    narrator "There was only darkness."

# game/scenes/adventure_prologue.rpy:24
translate english adv_prologue_8fb5abeb:

    # narrator "Dan sesuatu yang pucat, jauh di hujung jalan."
    narrator "And something pale, far down the road."

# game/scenes/adventure_prologue.rpy:25
translate english adv_prologue_259d632c:

    # narrator "Bila Nayan cuba tengok betul-betul, benda tu hilang celah pokok."
    narrator "When Nayan tried to look more closely, it vanished between the trees."

# game/scenes/adventure_prologue.rpy:28
translate english adv_prologue_ba74bf26:

    # nayan "Siapa tu?"
    nayan "Who's there?"

# game/scenes/adventure_prologue.rpy:29
translate english adv_prologue_88f4dd28:

    # narrator "Tak ada orang jawab."
    narrator "No one answered."

# game/scenes/adventure_prologue.rpy:30
translate english adv_prologue_7dc809a3:

    # narrator "Senyap tu yang menjawab."
    narrator "The silence answered for them."

# game/scenes/adventure_prologue.rpy:31
translate english adv_prologue_5fbb9f80:

    # narrator "Lepas beberapa saat, ada bunyi macam orang menangis dari arah kubur lama."
    narrator "After a few seconds, a sound like someone crying came from the old graveyard."

# game/scenes/adventure_prologue.rpy:34
translate english adv_prologue_fd71cda4:

    # narrator "Dia pujuk diri sendiri."
    narrator "He tried to calm himself."

# game/scenes/adventure_prologue.rpy:35
translate english adv_prologue_fa3a9c45:

    # narrator "Rumah dah dekat. Sikit je lagi."
    narrator "Home was close. Just a little farther."

# game/scenes/adventure_prologue.rpy:36
translate english adv_prologue_d0c0cf98:

    # narrator "Tapi kaki dia mula berat, macam tanah basah cuba tarik tapaknya."
    narrator "But his feet began to feel heavy, as if the wet earth were trying to pull at his soles."

# game/scenes/adventure_prologue.rpy:38
translate english adv_prologue_7dcce150:

    # narrator "Nayan percepatkan langkah."
    narrator "Nayan quickened his pace."

# game/scenes/adventure_prologue.rpy:39
translate english adv_prologue_c6889af2:

    # narrator "Di sebelah jalan, kain putih tersangkut pada pagar buluh, bergerak perlahan walaupun angin tak ada."
    narrator "By the roadside, a pale shroud had caught on a bamboo fence, shifting slowly though there was no wind."

# game/scenes/adventure_prologue.rpy:40
translate english adv_prologue_7f14972f:

    # narrator "Nayan hampir tergelak kecil, paksa diri percaya itu cuma kain orang jemur."
    narrator "Nayan almost let out a nervous laugh, forcing himself to believe it was only laundry left to dry."

# game/scenes/adventure_prologue.rpy:41
translate english adv_prologue_980a03b0:

    # narrator "Kemudian kain itu jatuh sendiri."
    narrator "Then the shroud fell on its own."

# game/scenes/adventure_prologue.rpy:42
translate english adv_prologue_04fd7c06:

    # narrator "Lepas tu dia dengar."
    narrator "Then he heard it."

# game/scenes/adventure_prologue.rpy:44
translate english adv_prologue_1b1bdc99:

    # narrator "Duk."
    narrator "Thud."

# game/scenes/adventure_prologue.rpy:45
translate english adv_prologue_1b1bdc99_1:

    # narrator "Duk."
    narrator "Thud."

# game/scenes/adventure_prologue.rpy:46
translate english adv_prologue_1b1bdc99_2:

    # narrator "Duk."
    narrator "Thud."

# game/scenes/adventure_prologue.rpy:51
translate english adv_prologue_603d9f38:

    # narrator "Sesuatu dalam kain putih bergerak ke arah dia."
    narrator "Something wrapped in a burial shroud moved toward him."

# game/scenes/adventure_prologue.rpy:52
translate english adv_prologue_6258fc57:

    # narrator "Bukan berjalan."
    narrator "Not walking."

# game/scenes/adventure_prologue.rpy:53
translate english adv_prologue_9c5fc486:

    # narrator "Melompat."
    narrator "Hopping."

# game/scenes/adventure_prologue.rpy:54
translate english adv_prologue_34318332:

    # narrator "Setiap lompatan ada jeda kecil."
    narrator "Each hop came with a small pause."

# game/scenes/adventure_prologue.rpy:55
translate english adv_prologue_85d8481a:

    # narrator "Cukup lama untuk Nayan sempat berharap ia berhenti."
    narrator "Long enough for Nayan to hope it would stop."

# game/scenes/adventure_prologue.rpy:56
translate english adv_prologue_a54d8632:

    # narrator "Cukup cepat untuk harapan tu mati balik."
    narrator "Fast enough for that hope to die again."

# game/scenes/adventure_prologue.rpy:63
translate english adv_prologue_1f9b45d0:

    # narrator "Jeritan tu tak sampai sesaat."
    narrator "The scream lasted less than a second."

# game/scenes/adventure_prologue.rpy:64
translate english adv_prologue_c0f53f19:

    # narrator "Esok paginya, Nayan dah tak bernyawa."
    narrator "By the next morning, Nayan was dead."

# game/scenes/adventure_prologue.rpy:65
translate english adv_prologue_2b55b135:

    # narrator "Telinga dia berdarah."
    narrator "His ears were bleeding."

translate english strings:

    # game/scenes/adventure_prologue.rpy:22
    old "Toleh ke belakang."
    new "Look back."

    # game/scenes/adventure_prologue.rpy:27
    old "Panggil ke dalam gelap."
    new "Call into the darkness."

    # game/scenes/adventure_prologue.rpy:33
    old "Terus jalan."
    new "Keep walking."

