# game/scenes/adventure_chapter1.rpy:14
translate english adv_chapter1_a0159fc5:

    # hafiz "Kampung Batu Layar. Kau pernah dengar pasal tempat tu?"
    hafiz "Kampung Batu Layar. Have you ever heard of that place?"

# game/scenes/adventure_chapter1.rpy:15
translate english adv_chapter1_ccc45bc2:

    # mc "Pocong?"
    mc "A creature?"

# game/scenes/adventure_chapter1.rpy:16
translate english adv_chapter1_f4ce9fe5:

    # hafiz "Itulah yang orang cakap. Ada benda melompat dekat kawasan kubur."
    hafiz "That's what people are saying. Something is hopping around the graveyard."

# game/scenes/adventure_chapter1.rpy:17
translate english adv_chapter1_5d74a358:

    # hafiz "Tapi cerita orang kampung ni pelik sikit."
    hafiz "But the villagers' story is a little strange."

# game/scenes/adventure_chapter1.rpy:18
translate english adv_chapter1_e9f5ca00:

    # hafiz "Dia tak muncul merata. Dia ulang jalan yang sama, macam ada benda yang belum selesai."
    hafiz "It doesn't appear just anywhere. It repeats the same path, like something was left unfinished."

# game/scenes/adventure_chapter1.rpy:20
translate english adv_chapter1_0e39b8c4:

    # narrator "Masa tu, telefon Aris berbunyi."
    narrator "Just then, Aris's phone rang."

# game/scenes/adventure_chapter1.rpy:31
translate english adv_chapter1_ef90bb2f:

    # melur "Encik... saya nak minta tolong pasal abang saya."
    melur "Sir... I need your help with my older brother."

# game/scenes/adventure_chapter1.rpy:32
translate english adv_chapter1_f9b5f09d:

    # melur "Abang saya dah lama meninggal. Tapi... dia masih ada dekat sana."
    melur "My brother died a long time ago. But... he's still there."

# game/scenes/adventure_chapter1.rpy:33
translate english adv_chapter1_b20cf725:

    # melur "Anak abang saya masih di kampung tu. Dia pun tak tahu cerita penuh."
    melur "My brother's child is still in that village. He doesn't know the full story either."

# game/scenes/adventure_chapter1.rpy:34
translate english adv_chapter1_972edd7d:

    # melur "Saya bukan minta encik bunuh dia."
    melur "I'm not asking you to kill him."

# game/scenes/adventure_chapter1.rpy:35
translate english adv_chapter1_bcb27ec7:

    # melur "Saya cuma tak sanggup dengar orang panggil dia bala sampai hari ni."
    melur "I just can't bear hearing people still call him a curse."

# game/scenes/adventure_chapter1.rpy:36
translate english adv_chapter1_13f0c27e:

    # melur "Tolong lepaskan dia dengan cara yang betul."
    melur "Please release him the right way."

# game/scenes/adventure_chapter1.rpy:49
translate english adv_chapter1_e6b4e298:

    # owner "Kalau pocong tu masih terikat, tengok simpulan kafan dulu."
    owner "If the creature is still bound, look at the knots in the burial shroud first."

# game/scenes/adventure_chapter1.rpy:50
translate english adv_chapter1_98356c14:

    # owner "Kalau jenazah diurus masa semua orang marah, atau semua nak cepat habis, roh boleh tersangkut."
    owner "If the body was prepared while everyone was angry, or while everyone just wanted it over with, the spirit can get trapped."

# game/scenes/adventure_chapter1.rpy:51
translate english adv_chapter1_20384802:

    # owner "Tapi jangan fikir simpulan tu cuma kain."
    owner "But don't think the knot is only cloth."

# game/scenes/adventure_chapter1.rpy:52
translate english adv_chapter1_7745aef9:

    # owner "Kadang-kadang simpulan yang paling ketat datang dari fitnah, takut, dan nama yang orang sengaja padam."
    owner "Sometimes the tightest knots come from slander, fear, and names people chose to erase."

# game/scenes/adventure_chapter1.rpy:54
translate english adv_chapter1_7b0722dd:

    # narrator "Abang Zul menghulur satu beg kecil kepada Aris."
    narrator "Abang Zul handed Aris a small bag."

# game/scenes/adventure_chapter1.rpy:55
translate english adv_chapter1_c04a8c3b:

    # narrator "Lampu suluh. Kamera telefon. Keris kecil. Buku nota kosong."
    narrator "A flashlight. A phone camera. A small keris. An empty notebook."

# game/scenes/adventure_chapter1.rpy:56
translate english adv_chapter1_39d9e314:

    # narrator "Dia letak beg tu perlahan-lahan, macam isinya bukan barang lawan, tapi tanggungjawab."
    narrator "He set the bag down gently, as if it held not weapons, but responsibility."

# game/scenes/adventure_chapter1.rpy:62
translate english adv_chapter1_d96fc79b:

    # mc "Kalau pengebumian dibuat tergesa-gesa?"
    mc "What if the burial was rushed?"

# game/scenes/adventure_chapter1.rpy:63
translate english adv_chapter1_386d9c21:

    # owner "Itu yang bahaya. Banyak benda boleh terlepas pandang. Simpulan kafan pun boleh tak sempat dibuka."
    owner "That's the danger. Many things can be overlooked. Even the knots in the shroud might not be untied in time."

# game/scenes/adventure_chapter1.rpy:64
translate english adv_chapter1_d90824b3:

    # owner "Bila orang urus jenazah dalam marah, mereka tutup tanah cepat-cepat."
    owner "When people bury the dead in anger, they cover the grave as fast as they can."

# game/scenes/adventure_chapter1.rpy:65
translate english adv_chapter1_0c343edb:

    # owner "Tapi benda yang tak disebut, tak semestinya ikut tertanam."
    owner "But what goes unspoken doesn't always stay buried with it."

# game/scenes/adventure_chapter1.rpy:70
translate english adv_chapter1_92648d34:

    # mc "Apa yang dia nak sebenarnya?"
    mc "What does it actually want?"

# game/scenes/adventure_chapter1.rpy:71
translate english adv_chapter1_f0976316:

    # owner "Bukan semua nak balas dendam. Ada yang cuma tak tahu nak pergi mana."
    owner "Not everything wants revenge. Some simply don't know where to go."

# game/scenes/adventure_chapter1.rpy:72
translate english adv_chapter1_25b76f64:

    # owner "Kalau dia pernah jadi manusia sebelum jadi cerita seram, cari dulu siapa dia."
    owner "If he was once a person before he became a horror story, find out who he was first."

# game/scenes/adventure_chapter1.rpy:73
translate english adv_chapter1_15166569:

    # owner "Nama kadang-kadang lebih kuat daripada bilah."
    owner "Sometimes a name is stronger than a blade."

# game/scenes/adventure_chapter1.rpy:78
translate english adv_chapter1_8fac882c:

    # mc "Kalau dia serang?"
    mc "What if it attacks?"

# game/scenes/adventure_chapter1.rpy:79
translate english adv_chapter1_13e34073:

    # owner "Bertahan dulu. Jangan terus ingat semua benda boleh selesai dengan senjata."
    owner "Defend yourself first. Don't assume every problem can be solved with a weapon."

# game/scenes/adventure_chapter1.rpy:80
translate english adv_chapter1_482df3ff:

    # owner "Keris boleh buka ruang. Tapi kalau dalam kepala kau cuma nak menang, kau balik dengan jawapan yang salah."
    owner "A keris can open space. But if all you want is to win, you'll come back with the wrong answer."

# game/scenes/adventure_chapter1.rpy:86
translate english adv_chapter1_ce94a48e:

    # hafiz "Kau nak aku ikut?"
    hafiz "Do you want me to come with you?"

# game/scenes/adventure_chapter1.rpy:90
translate english adv_chapter1_91fecd47:

    # mc "Aku pergi sorang."
    mc "I'll go alone."

# game/scenes/adventure_chapter1.rpy:91
translate english adv_chapter1_1bd89137:

    # narrator "Jalan ke Batu Layar terasa lebih jauh daripada sepatutnya."
    narrator "The road to Batu Layar felt longer than it should have."

# game/scenes/adventure_chapter1.rpy:95
translate english adv_chapter1_4ad951a6:

    # mc "Kau drive."
    mc "You drive."

# game/scenes/adventure_chapter1.rpy:96
translate english adv_chapter1_b2cf9bb7:

    # narrator "Hafiz tak tanya lebih."
    narrator "Hafiz didn't ask anything more."

# game/scenes/adventure_chapter1.rpy:97
translate english adv_chapter1_a6a01ac0:

    # narrator "Sebab itulah Aris percayakan Hafiz."
    narrator "That was why Aris trusted Hafiz."

translate english strings:

    # game/scenes/adventure_chapter1.rpy:61
    old "Tanya pasal pengebumian tergesa-gesa."
    new "Ask about rushed burials."

    # game/scenes/adventure_chapter1.rpy:69
    old "Tanya apa yang pocong tu nak."
    new "Ask what the creature wants."

    # game/scenes/adventure_chapter1.rpy:77
    old "Tanya cara nak hentikan dia."
    new "Ask how to stop it."

    # game/scenes/adventure_chapter1.rpy:89
    old "Pergi seorang. Lagi cepat."
    new "Go alone. It will be faster."

    # game/scenes/adventure_chapter1.rpy:94
    old "Biar Hafiz drive."
    new "Let Hafiz drive."

